# Django settings module for local development
DJANGO_SETTINGS_MODULE=config.settings.local
# Enable debug mode only in development
DEBUG=True
# Local-only secret key placeholder
SECRET_KEY=change-me
# Hosts allowed in local development
ALLOWED_HOSTS=127.0.0.1,localhost
# Canonical browser URL used by the web frontend
WEB_FRONTEND_URL=http://127.0.0.1:8000
# Optional extra browser origins if a separate frontend is introduced
WEB_ALLOWED_ORIGINS=
# Trusted CSRF origins for browser POST requests
CSRF_TRUSTED_ORIGINS=

# Database engine for local development: sqlite or mysql
DB_ENGINE=sqlite
# MySQL database name when DB_ENGINE=mysql
DB_NAME=
# MySQL username when DB_ENGINE=mysql
DB_USER=
# MySQL password when DB_ENGINE=mysql
DB_PASSWORD=
# MySQL host when DB_ENGINE=mysql
DB_HOST=
# MySQL port when DB_ENGINE=mysql
DB_PORT=

# Desktop client backend URL
API_BASE_URL=http://127.0.0.1:8000
# Desktop client timeout in seconds
API_TIMEOUT_SECONDS=10

# Session cookie is not readable by JavaScript
SESSION_COOKIE_HTTPONLY=True
# CSRF cookie remains readable by browser JavaScript
CSRF_COOKIE_HTTPONLY=False
# Keep secure cookies disabled in plain HTTP local development
SESSION_COOKIE_SECURE=False
# Keep secure CSRF cookies disabled in plain HTTP local development
CSRF_COOKIE_SECURE=False
# SameSite policy for session cookie
SESSION_COOKIE_SAMESITE=Lax
# SameSite policy for CSRF cookie
CSRF_COOKIE_SAMESITE=Lax
# Session lifetime in seconds
SESSION_COOKIE_AGE=1209600
# Expire session when the browser closes
SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# Trust X-Forwarded-* headers only behind a reverse proxy
USE_X_FORWARDED_PROTO=False
# Trust forwarded host header when proxy headers are enabled
USE_X_FORWARDED_HOST=False

# Application log level
LOG_LEVEL=INFO
# Django framework log level
DJANGO_LOG_LEVEL=WARNING
# Enable rotating file logs in local environments if needed
ENABLE_FILE_LOGGING=False
# Optional custom log directory path
LOG_DIR=
# Max size of application log file before rotation
APP_LOG_MAX_BYTES=10485760
# Number of rotated application log files to keep
APP_LOG_BACKUP_COUNT=5
# Max size of error log file before rotation
ERROR_LOG_MAX_BYTES=10485760
# Number of rotated error log files to keep
ERROR_LOG_BACKUP_COUNT=10
