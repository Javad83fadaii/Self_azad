# Django settings module for production
DJANGO_SETTINGS_MODULE=config.settings.production
# Debug must stay disabled in production
DEBUG=False
# Generate a long random secret outside the repository
SECRET_KEY=replace-with-a-long-random-secret
# Public hostnames served by Django
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# Public browser URL for the web frontend
WEB_FRONTEND_URL=https://your-domain.com
# Optional additional frontend origins when needed
WEB_ALLOWED_ORIGINS=
# Trusted HTTPS origins for browser session authentication
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Production MySQL database name
DB_NAME=ufrs_db
# Production MySQL username
DB_USER=ufrs_user
# Production MySQL password
DB_PASSWORD=replace-with-a-strong-password
# Production MySQL host
DB_HOST=127.0.0.1
# Production MySQL port
DB_PORT=3306

# Redirect all HTTP traffic to HTTPS
SECURE_SSL_REDIRECT=True
# HSTS duration in seconds
SECURE_HSTS_SECONDS=31536000
# Apply HSTS to subdomains when infrastructure is ready
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# Allow HSTS preload only after full domain readiness
SECURE_HSTS_PRELOAD=True
# Session cookie must stay unreadable by JavaScript
SESSION_COOKIE_HTTPONLY=True
# CSRF cookie must remain readable by browser JavaScript
CSRF_COOKIE_HTTPONLY=False
# Send session cookie only over HTTPS
SESSION_COOKIE_SECURE=True
# Send CSRF cookie only over HTTPS
CSRF_COOKIE_SECURE=True
# SameSite policy for session cookie
SESSION_COOKIE_SAMESITE=Lax
# SameSite policy for CSRF cookie
CSRF_COOKIE_SAMESITE=Lax
# Session lifetime in seconds
SESSION_COOKIE_AGE=43200
# Expire session when the browser closes
SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# Enable these when Django is behind Nginx or another reverse proxy
USE_X_FORWARDED_PROTO=True
USE_X_FORWARDED_HOST=True

# Application log level
LOG_LEVEL=INFO
# Django framework log level
DJANGO_LOG_LEVEL=WARNING
# Enable rotating file logs if logs are stored on disk
ENABLE_FILE_LOGGING=True
# Directory where rotating log files are written
LOG_DIR=/var/log/self_food
# Max size of application log file before rotation
APP_LOG_MAX_BYTES=10485760
# Number of rotated application log files to keep
APP_LOG_BACKUP_COUNT=5
# Max size of error log file before rotation
ERROR_LOG_MAX_BYTES=10485760
# Number of rotated error log files to keep
ERROR_LOG_BACKUP_COUNT=10
